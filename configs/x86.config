# =====================================================================
# OpenWrt X86_64 全功能固件配置（适用 Intel J1900 / J1800 软路由）
# 基于 Lede（Lean 大 OpenWrt，master = 24.10.x）
# 说明：
#  - 流量统计(nlbwmon)、TurboACC、luci、ssr-plus 等为 Lede router 默认内置插件
#    （lede include/target.mk 的 DEFAULT_PACKAGES.router），此处不再重复添加，
#    但它们会随固件自动编译进去，满足"不删除其他插件"要求。
#  - luci-app-passwall 使用 lede luci feed 自带版本（26.9.1），避免与外部仓库重复冲突。
#  - v2ray-geoip/geosite 由 Openwrt-Passwall/openwrt-passwall-packages 提供（v2ray-geodata），
#    构建工作流会自动克隆该仓库并去除与 lede feed 重复的子包。
# =====================================================================

# ---------- 目标平台 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# ---------- 固件镜像格式（全格式适配物理机/各种虚拟机） ----------
# 产出 ext4+squashfs × combined/combined-efi/rootfs + kernel.bin
# 及 VMDK(VMware)/VDI(VirtualBox)/QCOW2(PVE/KVM)/VHDX(Hyper-V)/ISO(LiveCD)
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_ISO_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_VDI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_VHDX_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_KERNEL_PARTSIZE=64

# ---------- 基础功能 ----------
# 说明：软件包管理(luci-app-opkg)在 OpenWrt 24.10 已并入 luci 本体(luci-mod-system)，无需单独插件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------- 主题 Argon ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- 代理：passwall + passwall2 ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

# ---------- 易有云文件管理器 + iStore 商店 ----------
# 易有云 = luci 界面(luci-app-linkease) + 守护进程(linkease，由 linkease/nas-packages 提供二进制)
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-i18n-linkease-zh-cn=y
CONFIG_PACKAGE_linkease=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
# 说明：iStore 商店界面自带简体中文（istore-ui 内置 zh-cn），无独立 luci-i18n-store 语言包

# ---------- 全能推送 + 微信推送 ----------
CONFIG_PACKAGE_luci-app-pushbot=y
CONFIG_PACKAGE_luci-i18n-pushbot-zh-cn=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# ---------- DDNS-GO + Lucky ----------
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# ---------- OAF 行为管理（lede feeds 自带版本，避免与外部仓库重复冲突） ----------
CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_luci-i18n-appfilter-zh-cn=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ---------- 网络工具 ----------
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ---------- Docker（概览/容器/镜像/网络/存储卷/事件/配置） ----------
# 说明：用 luci-app-dockerman（JS 版，菜单含 概览/容器/镜像/网络/存储卷/事件/配置）
#       替代 luci-app-docker（Lua 版仅为 Portainer 启动页，不满足菜单要求）
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y

# ---------- 网络共享（Samba4） ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# ---------- 文件列表 OpenList（Alist 继任者，luci-app-openlist 提供 alist 功能） ----------
CONFIG_PACKAGE_luci-app-openlist=y
CONFIG_PACKAGE_luci-i18n-openlist-zh-cn=y

# ---------- 流量统计（Lede 默认内置 nlbwmon） ----------
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ---------- TurboACC 网络加速（最新 BBR） ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# ---------- IP 限速（eqosplus） ----------
CONFIG_PACKAGE_luci-app-eqosplus=y
CONFIG_PACKAGE_luci-i18n-eqosplus-zh-cn=y

# ---------- Lua 兼容层（老版 LUA 应用需要） ----------
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
# luci-lib-ipkg 提供 luci.model.ipkg（易有云 linkease 依赖，24.10 已从 luci-base 移除）
CONFIG_PACKAGE_luci-lib-ipkg=y

# ---------- nftables/fw4 完整内核依赖（passwall 透明代理需要，避免"nftables环境不完整"警告） ----------
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-connlimit=y
CONFIG_PACKAGE_kmod-nft-nat6=y
CONFIG_PACKAGE_kmod-nft-dup-inet=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_fw4=y
